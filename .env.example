# Puerto local del servidor (Caddy lo publica en 443)
PORT=3000
HOST=0.0.0.0

# Carpeta donde viven la base, el secreto y los backups
DATA_DIR=./data

# URL pública (para enlaces en la página de descargas)
PUBLIC_URL=https://mismessenger.duckdns.org

# Repositorio de releases del cliente
RELEASES_URL=https://github.com/USUARIO/messenger-el-nacio/releases/latest

# Orígenes permitidos además de los de Tauri (separados por coma)
CORS_ORIGINS=

# Primer administrador (solo se usa si la base está vacía)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Días de retención por defecto (se puede cambiar desde el panel)
RETENTION_DAYS=30
