{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Messenger El Nacio",
  "version": "0.1.2",
  "identifier": "ar.edu.elnacio.messenger",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Messenger El Nacio",
        "width": 1000,
        "height": 700,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
