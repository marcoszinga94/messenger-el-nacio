  'd1c3b81f7495dc19451a97cc16c51a2e127e98ea7e21cab05b70184d6e7064c3'
  '70bead3e2546f0f44153b14e3e92b24d621c7ee4e7da36d49b8148ce88724d66'
  'd43a31fd424cc9c889ea758a451208eb74a4ab8cd1830aec05d13effb9f0db03'
)

package() {
  install -Dm755 "$srcdir/messenger-el-nacio" "$pkgdir/usr/bin/messenger-el-nacio"
