# Mantenedor: Marcos Zingaretti <marcoszinga94@users.noreply.github.com>
pkgname=messenger-el-nacio-bin
# MESSENGER_PKGVER permite fijar la versión sin editar el archivo (lo usa el CI).
pkgver=${MESSENGER_PKGVER:-0.1.2}
pkgrel=1
pkgdesc="Mensajería instantánea estilo MSN para la institución"
arch=('x86_64')
url="https://github.com/marcoszinga94/messenger-el-nacio"
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'openssl' 'glibc' 'gcc-libs' 'gst-plugins-good')
provides=('messenger-el-nacio')
conflicts=('messenger-el-nacio')
options=('!strip')
# MESSENGER_PORTABLE_TARBALL permite empaquetar un binario local (lo usa el CI,
# que compila antes de que exista el release). Sin esa variable se descarga el
# binario portable publicado en GitHub.
if [ -n "${MESSENGER_PORTABLE_TARBALL:-}" ]; then
  _portable_source="messenger-el-nacio-$pkgver.tar.gz::file://$MESSENGER_PORTABLE_TARBALL"
  _portable_sum='SKIP'
else
  _portable_source="messenger-el-nacio-$pkgver.tar.gz::https://github.com/marcoszinga94/messenger-el-nacio/releases/download/v$pkgver/Messenger.El.Nacio-${pkgver}-Linux-Portable-x86_64.tar.gz"
  _portable_sum='3223a9b3e1788d6b2b92df04ed511ec2740b3ef0063feb563b03ba6c8e7091b4'
fi

source=(
  "$_portable_source"
  "messenger-el-nacio.desktop"
  "messenger-el-nacio.png"
)
sha256sums=(
  "$_portable_sum"
  '70bead3e2546f0f44153b14e3e92b24d621c7ee4e7da36d49b8148ce88724d66'
  '5756a6c84ff3da7ba5f46b5c07eed71984d95f40c3840171cd65798218bf5ad9'
)

package() {
  install -Dm755 "$srcdir/messenger-el-nacio" "$pkgdir/usr/bin/messenger-el-nacio"
  install -Dm644 "$srcdir/messenger-el-nacio.desktop" \
    "$pkgdir/usr/share/applications/messenger-el-nacio.desktop"
  install -Dm644 "$srcdir/messenger-el-nacio.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/messenger-el-nacio.png"
}
